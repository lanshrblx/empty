local function DoLaundry()
    while true do
        fireproximityprompt(LaundryPrompt)

        local Laundred = true
        local Backpack = LocalPlayer.Backpack:GetChildren()
        for _, item in pairs(Backpack) do
            if item.Name == "Briefcase" then
                Laundred = false
            end
        end

        if Laundred then
            print("Отмыто успешно, завершаем функцию")
            break
        end
    end
end

local function DoBuy()
    while true do
        for AmountOfBought = 1, Config.AmountForBuying do
            print("Покупаем 1 шт предметов")
            fireproximityprompt(BuyPrompt)
            task.wait(0.1)
        end
        
        local CounterOfBoughtItems = 0
        local Backpack = LocalPlayer.Backpack:GetChildren()
        for _, item in pairs(Backpack) do
            if item.Name == Config.ItemForBuying then
                CounterOfBoughtItems+=1
            end
        end

        if CounterOfBoughtItems == Config.AmountForBuying then
            print("Куплено успешно, завершаем функцию")
            break
        end
        print("Не куплено нужное колличество, стараемся купить снова")
    end
end

local function DoSell()
    while true do
        fireproximityprompt(SellPrompt)

        local CounterOfSoldItems = 0
        local Backpack = LocalPlayer.Backpack:GetChildren()
        for _, item in pairs(Backpack) do
            if item.Name == Config.ItemForBuying then
                CounterOfSoldItems+=1
            end
        end

        if CounterOfSoldItems == 0 then
            print("Продано успешно, завершаем функцию")
            break
        end
        print("Проданы не все предметы, продаем снова")
        task.wait(1)
    end
end

