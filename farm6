local last_ex = 0
local delay = 5

local Start_value_coins = getInvetoryCoins()
local Start_value_summer_coins = getSummerCoins()

-- Счетчики заработанных монет за сессию
local earned_coins = 0
local earned_summer_coins = 0

-- Предыдущие значения для отслеживания прироста
local last_coins = Start_value_coins
local last_summer_coins = Start_value_summer_coins

-- Цели для смены сервера
local COINS_GOAL = 1000
local SUMMER_COINS_GOAL = 120

RunService.Heartbeat:Connect(function(delta)
    last_ex += delta
    if last_ex < delay then return end
    last_ex = 0

    local current_coins = getInvetoryCoins()
    local current_summer_coins = getSummerCoins()
    
    -- Отслеживаем прирост обычных монет
    local delta_coins = current_coins - last_coins
    if delta_coins > 0 then
        earned_coins = earned_coins + delta_coins
    end
    
    -- Отслеживаем прирост летних монет
    local delta_summer = current_summer_coins - last_summer_coins
    if delta_summer > 0 then
        earned_summer_coins = earned_summer_coins + delta_summer
    end
    
    -- Обновляем последние значения
    last_coins = current_coins
    last_summer_coins = current_summer_coins

    -- Открываем кейсы если хватает
    if current_coins >= 1000 then
        openCase()
    end

    if current_summer_coins >= 120 then
        openEventCase()
    end

    -- Проверяем заработанные монеты (не текущие в инвентаре)
    if earned_coins >= COINS_GOAL and earned_summer_coins >= SUMMER_COINS_GOAL then
		queue_on_teleport()
        teleportOnRandomServer(PLACES_IDS[math.random(1, #PLACES_IDS)])
        -- Сбрасываем счетчики после телепорта, чтобы не телепортироваться снова
        earned_coins = 0
        earned_summer_coins = 0
    end
end)

CoinsAfterExecution = getInvetoryCoins()
