local function startMM2Timer()
    print("In mm2, delay before tp: "..FARM_TIME.." sec")
    local elapsed = 0
    local connection
    
    connection = RunService.Heartbeat:Connect(function(deltaTime)
        elapsed = elapsed + deltaTime
        
        if elapsed >= FARM_TIME then
            connection:Disconnect() -- Отключаем событие
            stopFarming()
            teleportOnRandomServer(PLACES_IDS[math.random(1, #PLACES_IDS)])
        end
    end)
end

