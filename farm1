local function getTweenTime(targetPos)
	local root = getRoot()
	if not root then return MIN_TWEEN_TIME end

	local currentPos = root.CFrame.Position
	local distance = (currentPos - targetPos).Magnitude
	local time = distance / SPEED

	time = math.clamp(time, MIN_TWEEN_TIME, MAX_TWEEN_TIME)
	return time
end

