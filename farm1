local function CoinFarm(config)

	local reset_after = config["reset_after"] == true
	local total_coins = 0
	local limit_coins = 40
	local is_collecting = false
	local collected_coins = {}

	local function is_unique(coin)
		for _, val in collected_coins do
			if val == coin.CFrame then
				return false
			end
		end
		return true
	end

	local function getClosestCoin()
		local root = getRoot()
		if not root then 
			return nil 
		end

		local closest_coin = nil
		local closest_distance = math.huge
		local my_pos = root.CFrame.Position

		for _, val in workspace:GetDescendants() do
			if val and val.Name == "Coin_Server" and val.ClassName == "Part" and is_unique(val) and val:FindFirstChild("TouchInterest") then
				local distance = (my_pos - val.CFrame.Position).Magnitude
				if closest_distance > distance then
					closest_coin = val
					closest_distance = distance
				end
			end
		end

		return closest_coin
	end

	CoinCollected.OnClientEvent:Connect(function(got_type, got_total_coins, got_limit_coins, got_table)
		total_coins = got_total_coins
		limit_coins = got_limit_coins
		is_collecting = false

		print("Заработано за эту сессию: "..tostring(getInvetoryCoins()-CoinsAfterExecution))
		if reset_after and total_coins == limit_coins then
			local humanoid = getHumanoid()
			humanoid.Health = 0
		end
	end)


	while total_coins < limit_coins do
		-- ДОБАВЛЕНО: проверка флага остановки
		if stop_farming_flag then
			break
		end

		if is_collecting then
			task.wait(0.1)
			is_collecting = false
			continue
		end

		local coin = getClosestCoin()
		if coin == nil then
			task.wait(0.1)
			continue
		end

		local tweenTime = getTweenTime(coin.CFrame.Position)

		local tween = TS:Create(getRoot(), TweenInfo.new(tweenTime), {CFrame = coin.CFrame})
		tween:Play()

		is_collecting = true
		table.insert(collected_coins, coin.CFrame)
		coins_object.Text = "💸 Farmed Coins: "..tostring(#collected_coins)

		while tween.PlaybackState ~= Enum.PlaybackState.Completed do
    		task.wait()  -- НЕ БЛОКИРУЕТ
		end

        if getInvetoryCoins()>=1000 then
            openCase()
        end

		task.wait(0.25)
	end

end

local function stopFarming()
	stop_farming_flag = true
	if current_farm_task then
		task.cancel(current_farm_task)
		current_farm_task = nil
	end
end

local function startFarming()
	stop_farming_flag = false
	current_farm_task = task.spawn(function()
		CoinFarm(config)
	end)
end

